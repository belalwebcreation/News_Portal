{
  "name": "news_portal",
  "version": "1.0.0",
  "description": "MERN Stack News Portal",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server.js",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "mern",
    "news-portal",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Belal Hossain",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.1",
    "fast-json-patch": "^3.1.1",
    "formidable": "^3.5.4",
    "google-auth-library": "^10.9.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "monent": "^0.0.2-security",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.30.1",
    "streamifier": "^0.1.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}